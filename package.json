{
  "name": "range-navigator",
  "displayName": "Range Navigator",
  "description": "Find all occurrences of selected text and display them in sidebar",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {

    "viewsContainers": {
      "activitybar": [
        {
          "id": "range-navigator",
          "title": "Range Navigator",
          "icon": "resources/navigator.svg"
        }
      ]
    },
    "views": {
      "range-navigator": [
        {
          "id": "rangeNavigatorView",
          "name": "Text Occurrences"
        }
      ]
    },
    "commands": [
      {
        "command": "range-navigator.findOccurrences",
        "title": "Find Text Occurrences"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.54.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
